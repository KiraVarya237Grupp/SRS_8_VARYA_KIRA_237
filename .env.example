# Секретный ключ Django (замените на собственный при развертывании)
DJANGO_SECRET_KEY=your-secret-key-example-change-me-in-production

# Режим отладки (True для локальной разработки, False для продакшена)
DJANGO_DEBUG=True

# Разрешенные хосты
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# Доверенные источники для CSRF-защиты
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Строка подключения к БД (локально SQLite, на Render — Internal Database URL PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3